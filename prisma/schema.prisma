// Oswin Work OS — domain schema
// SQLite for dev (portable to Postgres). Prisma 7 `prisma-client` generator.
// Note: SQLite has no native enums — string fields document allowed values.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Org & access control ───────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  // Approved "From" addresses an admin configures once (Requirement #1). JSON
  // array of email strings; the composer's From dropdown is built from these
  // plus the signed-in user's own email.
  emailSenders String @default("[]")
  createdAt DateTime @default(now())

  users        User[]
  roles        Role[]
  departments  Department[]
  environments Environment[]
  invitations  Invitation[]
  invoices     Invoice[]
  employers    Employer[]
  emails       EmailMessage[]
  connectedEmails ConnectedEmailAccount[]
  docusign     ConnectedDocuSignAccount?
  envelopes    DocuSignEnvelope[]
}

// A DocuSign account connected to an org via OAuth (Authorization Code Grant).
// One per org. Tokens let us create/send envelopes and read status on its behalf.
model ConnectedDocuSignAccount {
  id           String    @id @default(cuid())
  orgId        String    @unique
  userId       String    // who connected it
  accountId    String    // DocuSign API account id
  accountName  String    @default("")
  baseUri      String    // e.g. https://demo.docusign.net (account base URI)
  email        String    @default("")
  accessToken  String    @default("")
  refreshToken String    @default("")
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// One e-signature envelope sent for an item, tracked on the board.
// status: created | sent | delivered | viewed | signed(completed) | declined | voided | expired
model DocuSignEnvelope {
  id             String    @id @default(cuid())
  orgId          String
  itemId         String
  boardId        String    @default("")
  envelopeId     String    @default("")
  status         String    @default("created")
  recipientEmail String    @default("")
  recipientName  String    @default("")
  subject        String    @default("")
  signedFileUrl  String    @default("")
  statusColumnId String?   // board column to write the status into
  signedColumnId String?   // file column to upload the signed doc into
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([itemId])
  @@index([envelopeId])
}

// Roles hold a JSON permission set. isSystem roles (Admin/Member/Viewer/Developer)
// ship by default; users can add/edit/remove custom roles.
model Role {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  color       String   @default("#5B7A99")
  permissions String   @default("{}") // JSON: { boards:"all"|ids[], canEditColumns, canManageUsers, ... }
  isSystem    Boolean  @default(false)
  rank        Int      @default(100) // lower = more powerful (Admin=0)
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users User[]

  @@unique([orgId, name])
}

model Department {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String   @default("#0B7A6F")
  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users User[]

  @@unique([orgId, name])
}

// status: active | inactive | unavailable | viewer
model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  name         String
  passwordHash String? // null for pure Google sign-in
  avatarColor  String   @default("#0B7A6F")
  avatarUrl    String? // uploaded profile picture (data URL) — falls back to initials
  status       String   @default("active")
  roleId       String?
  departmentId String?
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role       Role?        @relation(fields: [roleId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])

  sessions       Session[]
  assignedCells  Cell[] // person-column assignments referencing this user
  updates        Update[]
  invitesCreated Invitation[]
  emailsSent     EmailMessage[]
  connectedEmails ConnectedEmailAccount[]
}

// A user-authorized external email account (Requirement #1 — "+ Add Email").
// Connected via Google OAuth so the platform can send true "as" emails without
// the user creating a separate platform account. Tokens let us send via SMTP
// XOAUTH2 / the Gmail API on their behalf; refreshToken renews the access token.
// provider: google (extensible to microsoft later).
model ConnectedEmailAccount {
  id           String    @id @default(cuid())
  orgId        String
  userId       String
  email        String
  provider     String    @default("google")
  accessToken  String    @default("")
  refreshToken String    @default("")
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// status: pending | accepted | revoked  · role assigned on accept
model Invitation {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  roleId    String?
  invitedBy String?
  status    String   @default("pending")
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter User?        @relation(fields: [invitedBy], references: [id])
}

// ─────────────────────────── Work OS core ───────────────────────────

model Environment {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  color      String    @default("#0B7A6F")
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  archivedAt DateTime? // soft-delete → shows in Archive/Trash, restorable

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boards Board[]
}

model Board {
  id            String   @id @default(cuid())
  environmentId String
  name          String
  description   String   @default("")
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  archivedAt    DateTime? // soft-delete → shows in Archive/Trash, restorable

  // Display label for the built-in "Item" column (Improvement 3), e.g.
  // "Candidate Name". Empty string = show the default "Item" label. This is a
  // presentation-only override — item ids/relationships/APIs are unaffected.
  itemColumnName String @default("")

  // Public intake form (Part 10)
  formEnabled Boolean @default(false)
  formTitle   String  @default("")
  formDesc    String  @default("")
  formConfig  String  @default("{}") // JSON: { columns: string[], dedupeColumnId?: string }
  formSlug    String? @unique // short code for a shareable /f/<slug> link

  environment  Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  groups       Group[]
  columns      Column[]
  items        Item[]
  automations   Automation[]
  views         BoardView[]
  docTemplates  DocTemplate[]
  reminderRules ReminderRule[]
  forms         Form[]
}

// A public intake form on a board. A board may have many (no limit); each has
// its own destination group, welcome message and short /f/<slug> link.
model Form {
  id        String   @id @default(cuid())
  boardId   String
  title     String   @default("")
  desc      String   @default("")
  enabled   Boolean  @default(true)
  config    String   @default("{}") // JSON: { columns, dedupeColumnId, groupId, welcomeMessage }
  slug      String?  @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model Group {
  id       String @id @default(cuid())
  boardId  String
  name     String
  color    String @default("#5B7A99")
  position Int    @default(0)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items Item[]
}

// type: text | longtext | status | person | date | file | number | email | phone | connection | mirror
// config: JSON — e.g. status { labels:[{id,label,color}] }
model Column {
  id       String  @id @default(cuid())
  boardId  String
  name     String
  type     String
  config   String  @default("{}")
  position Int     @default(0)
  hidden   Boolean @default(false)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cells Cell[]
}

model Item {
  id        String   @id @default(cuid())
  boardId   String
  groupId   String
  name      String
  position  Int      @default(0)
  // Subitems (Feature 1): when set, this item is a subitem/endorsement nested
  // under `parent`, typically created when a new record matches an existing
  // item's email so we group related records under one person instead of
  // duplicating the main item. Null = a normal/main item.
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board       Board               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent      Item?               @relation("ItemSubitems", fields: [parentId], references: [id], onDelete: Cascade)
  subitems    Item[]              @relation("ItemSubitems")
  cells       Cell[]
  updates     Update[]
  documents   GeneratedDocument[]
  employerTags CandidateTag[]
  emails      EmailMessage[]
  envelopes   DocuSignEnvelope[]

  @@index([boardId])
  @@index([groupId])
  @@index([parentId])
}

// value holds the raw cell value (string / ISO date / number / label id).
// personId is set for person columns (FK to User) so we can query assignments.
model Cell {
  id       String  @id @default(cuid())
  itemId   String
  columnId String
  value    String?
  personId String?

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  person User?  @relation(fields: [personId], references: [id])

  @@unique([itemId, columnId])
  @@index([columnId])
}

model Update {
  id        String   @id @default(cuid())
  itemId    String
  authorId  String?
  body      String
  mentions  String   @default("[]") // JSON array of userIds / departmentIds
  createdAt DateTime @default(now())

  item   Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])
}

// Saved filtered/hidden-column presentation of a board.
// A saved, typed presentation of a board shown as its own tab.
// type: table | kanban | calendar | chart | dashboard
// config JSON: table/kanban/calendar/chart → { hiddenColumns:[], filters:[] };
//              dashboard → { widgets: Widget[] }  (see dashboard widget builder)
model BoardView {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  type      String   @default("table")
  config    String   @default("{}")
  isPinned  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

// Document generation (Part 11) — DocuGen-style.
// body holds text with {{Placeholders}} that map to column names or {{Item}}.
// DocuGen template (Part: Additional DocuGen features). Two kinds:
//   kind="text"  → legacy inline body with {{Placeholders}} (kept working)
//   kind="docx"  → an uploaded .docx filled via docxtemplater; output DOCX/PDF
model DocTemplate {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  body      String   @default("")          // legacy text template body
  kind      String   @default("text")      // "text" | "docx"

  // DocuGen metadata
  reference String   @default("")           // stable ref, e.g. DG-001 (never changes on rename)
  viewName  String   @default("")           // DocuGen view name/number
  employer  String   @default("")
  category  String   @default("")
  folder    String   @default("")

  // Uploaded .docx (kind="docx")
  docxUrl      String  @default("")          // blob URL (or data URL fallback)
  docxName     String  @default("")          // original filename
  placeholders String  @default("[]")        // JSON: detected placeholder names
  mapping      String  @default("{}")        // JSON: placeholder -> column NAME / {{Item}}

  // Output
  outputFormat   String  @default("docx")    // "docx" | "pdf"
  outputColumnId String?                     // File column to save the generated doc into

  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board     Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  documents GeneratedDocument[]
  versions  DocTemplateVersion[]

  @@index([boardId])
}

// Version history for a DocuGen template (version control + replace/keep).
model DocTemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  version    Int
  docxUrl    String   @default("")
  docxName   String   @default("")
  mapping    String   @default("{}")
  note       String   @default("")
  createdAt  DateTime @default(now())

  template DocTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// A filled document generated from a template + an item's data.
model GeneratedDocument {
  id         String   @id @default(cuid())
  itemId     String
  templateId String?
  name       String
  html       String
  content    String   @default("[]") // structured blocks JSON for PDF/DOCX export
  createdAt  DateTime @default(now())

  item     Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  template DocTemplate? @relation(fields: [templateId], references: [id])

  @@index([itemId])
}

// Candidate → Employer tagging (Part 15) — native, with live stage counts.
model Employer {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  contactEmail String   @default("")
  contactPhone String   @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())

  org  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tags CandidateTag[]

  @@unique([orgId, name])
}

// stage: interview | active | placed | past
model CandidateTag {
  id         String   @id @default(cuid())
  employerId String
  itemId     String
  stage      String   @default("interview")
  createdAt  DateTime @default(now())

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([employerId, itemId])
  @@index([itemId])
}

// Date-based reminders (Part 14) — e.g. visa expiry: notify N days before a date.
model ReminderRule {
  id                 String   @id @default(cuid())
  boardId            String
  name               String
  dateColumnId       String
  offsets            String   @default("[30,21,14,7,5,3,2,1]") // JSON array of days-before
  notifyDepartmentId String?
  message            String   @default("")
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())

  board Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  logs  ReminderLog[]
}

// One row per (rule, item, offset) already fired — prevents duplicate sends.
model ReminderLog {
  id         String   @id @default(cuid())
  ruleId     String
  itemId     String
  offsetDays Int
  createdAt  DateTime @default(now())

  rule ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, itemId, offsetDays])
}

// Finance / Accounts (Part 17).
// account: pty (Osphine PTY, offshore) | global (Osphine Global, Dubai)
// status: requested → approved → invoiced → paid  (or rejected)
model Invoice {
  id              String   @id @default(cuid())
  orgId           String
  account         String   @default("pty")
  candidateName   String
  candidateEmail  String   @default("")
  amountCents     Int      @default(0)
  currency        String   @default("AUD")
  description     String   @default("")
  department      String   @default("")
  status          String   @default("requested")
  stripeInvoiceId String?
  stripeUrl       String?
  paymentMethod   String   @default("stripe") // stripe | offline
  requestedById   String?
  approvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Email conversation history (Missing #2). Every email sent from the platform
// to a candidate/user is recorded here, plus manual log entries and (later)
// inbound replies — so the whole thread is visible on the item's profile.
// direction: outbound | inbound | note   ·   status: sent | skipped | failed
model EmailMessage {
  id        String   @id @default(cuid())
  orgId     String
  itemId    String? // linked candidate/item, when the email relates to one
  direction String   @default("outbound")
  status    String   @default("sent")
  fromEmail String   @default("")
  toEmail   String   @default("")
  ccEmail   String   @default("")
  bccEmail  String   @default("")
  subject   String   @default("")
  body      String   @default("")
  attachments String @default("[]") // JSON array of { name } (filenames only)
  authorId  String? // team member who sent/logged it
  createdAt DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item   Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User?        @relation(fields: [authorId], references: [id])

  @@index([itemId])
  @@index([orgId])
}

// User-built "when trigger → do action" rules.
// trigger/action stored as JSON so the builder stays flexible.
model Automation {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  folder    String   @default("") // client wants folders + search
  position  Int      @default(0) // order within a folder (drag-and-drop)
  enabled   Boolean  @default(true)
  trigger   String   @default("{}") // JSON
  action    String   @default("{}") // JSON — single Action or { type:"multi", actions:[] }
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}
